{
  "name": "@fmarlats/react-like-button",
  "version": "1.3.1",
  "description": "Animated React reaction button with multi-click fill states, customizable particles, shapes, icons, and cursors. Includes Tailwind CSS and vanilla CSS versions.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/cjs/vanilla.d.ts",
        "default": "./dist/cjs/vanilla.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./like-button.css": "./dist/like-button.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/build-css.js",
    "dev": "concurrently --kill-others --names bundles,types-esm,types-cjs \"node esbuild.config.mjs --watch\" \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.build.cjs.json --watch --preserveWatchOutput\"",
    "demo:hero": "vite docs/hero-demo --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "prepublishOnly": "pnpm run ci && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "react",
    "react-component",
    "like-button",
    "like",
    "button",
    "animation",
    "animated-button",
    "particles",
    "particle-effects",
    "liquid-fill",
    "liquid-animation",
    "wave-animation",
    "brutalist",
    "brutalist-design",
    "tailwind",
    "tailwindcss",
    "vanilla-css",
    "typescript",
    "interactive",
    "ui-component",
    "react-ui",
    "engagement",
    "social",
    "heart-button",
    "favorite-button",
    "upvote",
    "rating",
    "feedback",
    "click-animation",
    "micro-interaction",
    "headless-ui",
    "customizable",
    "accessible",
    "a11y",
    "multiple-likes"
  ],
  "author": "Florian MARLATS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmarlats/react-like-button.git"
  },
  "homepage": "https://github.com/fmarlats/react-like-button#readme",
  "bugs": {
    "url": "https://github.com/fmarlats/react-like-button/issues"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
